    test("test-dataset_cellrangermulti_mixed_vdj_feature_types_quoted_padded") {
        tag "validation"
        tag "cellranger/multi"
        tag "initialisation"

        when {
            params {
                aligner                   = 'cellrangermulti'
                outdir                    = "${outputDir}/results_cellrangermulti_mixed_vdj_feature_types_quoted_padded"
                // quoted fields with padded sample name and feature type, which the samplesheet parser normalises
                input                     = "${baseDir}/assets/cellrangermulti_samplesheet_test_mixed_vdj_quoted_padded.csv"
                protocol                  = 'auto'
                skip_cellbender           = true
            }
            workflow {
                """
                input[0] = false  // version
                input[1] = true   // validate_params
                input[2] = false  // monochrome_logs
