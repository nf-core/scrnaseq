    }

    test("test-dataset_cellrangermulti_vdj_feature_types_per_sample") {
        tag "validation"
        tag "cellranger/multi"
        tag "initialisation"

        when {
            params {
                aligner                   = 'cellrangermulti'
                outdir                    = "${outputDir}/results_cellrangermulti_vdj_feature_types_per_sample"
                input                     = "${baseDir}/assets/cellrangermulti_samplesheet_test_vdj_chain_types.csv"
                protocol                  = 'auto'
                skip_cellbender           = true
            }
            workflow {
                """
                input[0] = false  // version
                input[1] = true   // validate_params
                input[2] = false  // monochrome_logs
                input[3] = []     // nextflow_cli_args
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false  // help
                input[7] = false  // help_full
                input[8] = false  // show_hidden
                """
            }
        }

        then {
            // different samples may use the generic 'vdj' and chain-specific feature types
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // one entry per sample and feature type: [ sample, feature_type, FASTQ file names ]
                    workflow.out.samplesheet
                        .collect { meta, fastqs -> [ meta.id, meta.feature_type, fastqs.collect { fastq -> file(fastq).name } ] }
                        .sort { entry -> entry.toString() }
                ).match() }
            )
        }
    }
}
